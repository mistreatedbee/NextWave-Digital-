{
  "name": "nextwave-digital-solutions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "dev:full": "concurrently -k \"npm run dev\" \"npm run dev:api\"",
    "dev:api": "tsx watch server.ts",
    "db:migrate": "node --import tsx --input-type=module -e \"import fs from 'node:fs'; import dotenv from 'dotenv'; import pg from 'pg'; dotenv.config({path:'./.env.local'}); const c=new pg.Client({connectionString:process.env.DATABASE_URL,ssl:{rejectUnauthorized:false}}); await c.connect(); await c.query(fs.readFileSync('./supabase/migrations/20261125_nextwave_core.sql','utf8')); await c.end(); console.log('Migration applied');\"",
    "build": "npx vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "preview": "npx vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@supabase/supabase-js": "^2.48.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "framer-motion": "^11.5.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "0.522.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.7.0",
    "concurrently": "^10.0.7",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.2.0"
  }
}
