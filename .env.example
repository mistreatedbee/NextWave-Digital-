# Insforge / Supabase (required for admin and API-backed content)
VITE_INSFORGE_URL=https://your-project.supabase.co
VITE_INSFORGE_ANON_KEY=your-anon-key

# Management system API (server only; never prefix these with VITE_)
DATABASE_URL=postgres://user:password@host:5432/database
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Documents: emailing PDFs (https://resend.com). EMAIL_FROM must use a domain you have verified there.
RESEND_API_KEY=
EMAIL_FROM="NextWave Digital Solutions <documents@your-verified-domain>"
# Optional: where replies go, and the address used in client links (defaults to the company website)
EMAIL_REPLY_TO=
APP_URL=
# Local only: path to Chrome if it isn't in the usual place
CHROME_PATH=
# Protects the daily reminder job; at least 32 random characters
CRON_SECRET=
